# Replace with your MongoDB Atlas connection string
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=
NEXTAUTH_SECRET=your-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:3000

# Wahoo Fitness API – register at https://developers.wahooligan.com
WAHOO_CLIENT_ID=your_wahoo_client_id
WAHOO_CLIENT_SECRET=your_wahoo_client_secret
WAHOO_WEBHOOK_TOKEN=your_wahoo_webhook_token

# PayPal – register at https://developer.paypal.com
# Set PAYPAL_SANDBOX=true for sandbox/test environment
PAYPAL_SANDBOX=true
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# Run: npx ts-node --skip-project scripts/paypal-setup.ts
PAYPAL_PLAN_ID=your_paypal_plan_id
# Register webhook at developer.paypal.com → My Apps → Webhooks
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

NEXT_PUBLIC_APP_URL=http://localhost:3000
